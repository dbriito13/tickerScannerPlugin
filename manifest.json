{
  "manifest_version": 3,
  "name": "TickerLens",
  "version": "0.1.0",
  "description": "Detect ETF/fund tickers in forums and highlight them with quick info.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://community.rationalreminder.ca/*"],
      "js": ["tickers.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png"
  }
}
